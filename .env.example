# Copy to .env and fill in. .env is gitignored.

# --- LLM (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash
# Reasoning models need room for reasoning_content; 800 produces empty bodies.
OPENAI_MAX_TOKENS=16384
OPENAI_TIMEOUT=120
OPENAI_MAX_RETRIES=3

# --- Embeddings (optional; Cohere first, then OpenAI-compatible /embeddings) ---
# COHERE_API_KEY=
# COHERE_EMBED_MODEL=embed-v5.0-fast
# REVIEW_CONTEXT_ENABLED=true
# REVIEW_CONTEXT_TOP_K=12

# --- GitHub App (preferred for production) ---
# GITHUB_APP_ID=123456
# GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem
# GITHUB_WEBHOOK_SECRET=change-me
# GITHUB_INSTALLATION_ID=78910   # optional default for CLI runs

# --- GitHub PAT fallback (simpler, less production-grade) ---
# GITHUB_TOKEN=

# --- Review behaviour ---
REVIEW_MODE=security          # general | security | pattern | ensemble
REVIEW_DRY_RUN=true           # set false only after shadow validation
REVIEW_ALLOWED_REPOS=         # empty = all installations; comma-separated owner/repo
REVIEW_DRAFTS=false
REVIEW_MIN_SEVERITY=medium
REVIEW_MAX_FINDINGS=10
REVIEW_MAX_INLINE_COMMENTS=20
REVIEW_MAX_DIFF_CHARS=12000
REVIEW_POST_EMPTY_SUMMARY=false  # true = post a "no findings" summary
REVIEW_POST_ON_PARTIAL=false   # fail closed if one diff chunk fails
REVIEW_SKIP_BOTS=true
REVIEW_CACHE_ENABLED=true

# --- Knowledge (optional) ---
REVIEW_POLICY_ENABLED=true
REVIEW_POLICY_PATH=policies/security.json
REVIEW_PROMPT_DIR=prompts
REVIEW_AUDIT_PATH=data/audit.jsonl
REVIEW_HISTORY_ENABLED=false   # write posted findings and retrieve similar past ones
REVIEW_HISTORY_PATH=data/history.jsonl
REVIEW_DEPENDENCY_ENABLED=false  # inject intra-repo Python/C/C++/JS/TS dependency graphs

# --- Storage ---
DATABASE_PATH=data/codereview.db
CHROMA_PATH=data/chroma
CACHE_DIR=data/cache
REPO_CACHE_KEEP=3
REPO_MAX_MB=200

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
REVIEW_CONCURRENCY=2
LOG_LEVEL=INFO
METRICS_ENABLED=true
